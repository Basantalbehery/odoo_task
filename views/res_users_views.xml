<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_users_from_inherit_equipment" model="ir.ui.view">
        <field name="name">res.users.from.inherit.equipment</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Equipment Loans">
                    <field name="equipment_loan_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>