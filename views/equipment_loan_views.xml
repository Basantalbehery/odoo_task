<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_equipment_loan_form" model="ir.ui.view">
        <field name="name">equipment.loan.form</field>
        <field name="model">equipment.loan</field>
        <field name="arch" type="xml">
            <form string="Equipment Loan Request">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_return" type="object" string="Return Equipment" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="borrower_id"/>
                            <field name="item_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_due"/>
                            <field name="date_return"/>
                            <field name="daily_rate"/>
                            <field name="total_price"/>
                            <field name="days_late" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note" placeholder="Add internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_equipment_loan_list" model="ir.ui.view">
        <field name="name">equipment.loan.list</field>
        <field name="model">equipment.loan</field>
        <field name="arch" type="xml">
            <list string="Equipment Loans">
                <field name="name"/>
                <field name="borrower_id"/>
                <field name="item_id"/>
                <field name="date_start"/>
                <field name="date_due"/>
                <field name="total_price"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>


    <record id="action_equipment_loan" model="ir.actions.act_window">
        <field name="name">Equipment Loans</field>
        <field name="res_model">equipment.loan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>