<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_loan_tree" model="ir.ui.view">
        <field name="name">equipment.loan.list</field>
        <field name="model">equipment.loan</field>
        <field name="arch" type="xml">
            <list string="Equipment Loans">
                <field name="item_id"/>
                <field name="borrower_id"/>
                <field name="date_start"/>
                <field name="date_due"/>
                <field name="days_late" decoration-danger="days_late &gt; 0"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_loan_form" model="ir.ui.view">
        <field name="name">equipment.loan.form</field>
        <field name="model">equipment.loan</field>
        <field name="arch" type="xml">
            <form string="Equipment Loan">
                <header>
                    <button name="action_confirm" type="object" string="Confirm Loan" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_return" type="object" string="Return Equipment" class="oe_highlight" invisible="status != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="status not in ('draft', 'confirmed')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Loan Details">
                            <field name="item_id"/>
                            <field name="borrower_id"/>
                            <field name="daily_rate"/>
                            <field name="total_price"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Dates &amp; Timing">
                            <field name="date_start"/>
                            <field name="date_due"/>
                            <field name="date_return" invisible="state != 'returned'"/>
                            <field name="days_late" invisible="days_late == 0"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Add additional information..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_equipment_loan" model="ir.actions.act_window">
        <field name="name">Equipment Loans</field>
        <field name="res_model">equipment.loan</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>