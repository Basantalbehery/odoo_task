<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="equipment_item_view_kanban" model="ir.ui.view">
        <field name="name">equipment.item.kanban</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click d-flex gap-3 align-items-center">
                            <div class="o_kanban_image" style="width: 60px; height: 60px;">
                                <field name="image_1920" widget="image"/>
                            </div>
                            <div class="oe_kanban_details flex-grow-1">
                                <strong class="o_kanban_record_title fs-6">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted small">
                                    <field name="category_id"/>
                                </div>
                                <div class="fw-bold text-primary mt-1">
                                    <field name="daily_rate"/> / day
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_equipment_item_form" model="ir.ui.view">
        <field name="name">equipment.item.form</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <form string="Equipment Item">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Item Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="daily_rate"/>
                            <field name="condition_score"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_equipment_item_list" model="ir.ui.view">
        <field name="name">equipment.item.list</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <list string="Equipment Items">
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="daily_rate"/>
                <field name="condition_score"/>
            </list>
        </field>
    </record>


    <record id="action_equipment_item" model="ir.actions.act_window">
        <field name="name">Equipment Items</field>
        <field name="res_model">equipment.item</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>