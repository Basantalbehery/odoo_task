<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_loan_tree" model="ir.ui.view">
        <field name="name">equipment.loan.list</field>
        <field name="model">equipment.loan</field>
        <field name="arch" type="xml">
            <list string="Equipment Loans">
                <field name="item_id"/>
                <field name="borrower_id"/>
                <field name="date_start"/>
                <field name="date_due"/>
                <field name="status"/>
            </list>
        </field>
    </record>

                <field name="name"/>
                <field name="category_id"/>
                <field name="daily_rate"/>
                <field name="status" widget="badge" decoration-success="status == 'available'" decoration-warning="status == 'on_loan'" decoration-danger="status ==in ('maintenance', 'scrapped')"/>
                <field name="company_id" group="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_item_kanban" model="ir.ui.view">
        <field name="name">equipment.item.kanban</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="status"/>
                <field name="image_1920"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center">
                            <field name="image_1920" widget="image" class="avatar me-2" style="width: 50px; height: 50px; object-fit: cover;"/>
                            <div>
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <die><small class="text-muted"><field name="code"/></small></die>
                                <div><field name="status" widget="label_selection" options="{'class': {'available': 'success', 'on_loan': 'warning', 'maintenance': 'danger'}}"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_equipment_item_form" model="ir.ui.view">
        <field name="name">equipment.item.form</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <form string="Equipment Item">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="available,on_loan,maintenance,scrapped"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-history" type="action" name="%(action_equipment_loan)d" context="{'search_default_item_id': id}">
                            <div class="o_stat_info">
                                <field name="loan_count" class="o_stat_value"/>
                                <span class="o_stat_text">Loans</span>
                            </div>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Item Name..."/>
                        </h1>
                        <h3>
                            <field name="code"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="daily_rate"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="condition_score"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_equipment_item" model="ir.actions.act_window">
        <field name="name">Equipment Items</field>
        <field name="res_model">equipment.item</field>
        <field name="view_mode">kanban,list,form</field>
    </record>